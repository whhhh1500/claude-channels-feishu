{
  "description": "飞书开关打开时，授权请求和计划确认转到飞书卡片，选择框提问改成文字提问（电脑和飞书都能答），并把对话记录的位置告诉插件（插件跟读它，把电脑上的内容同步到飞书）；开关关着时立即放行，照常在电脑上处理",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/server/feishu-channel",
            "args": ["hook"],
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/server/feishu-channel",
            "args": ["hook"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/server/feishu-channel",
            "args": ["hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/server/feishu-channel",
            "args": ["hook"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
